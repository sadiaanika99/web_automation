# Copy this file to .env and fill in the account you manually created
# at https://www.automationexercise.com/signup before running the tests.
# Never commit your real .env file.

BASE_URL=https://www.automationexercise.com
LOGIN_EMAIL=your_registered_email@example.com
LOGIN_PASSWORD=your_registered_password
LOGIN_FIRST_NAME=YourFirstName

# Set to false to watch the browser instead of running headless
HEADLESS=true
